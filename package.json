{
  "name": "manju-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 漫剧分镜画布：图片 / 视频 / 3D 导演台节点，接入 Agnes 文本、图像、视频模型",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@xyflow/react": "^12.3.5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
